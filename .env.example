# Polymarket Configuration
POLYMARKET_WS_URL=wss://ws-subscriptions-clob.polymarket.com/ws/market
POLYMARKET_API_URL=https://clob.polymarket.com

# API Authentication (optional - required for live trading)
POLYMARKET_API_KEY=
POLYMARKET_PRIVATE_KEY=

# Arbitrage Detection Settings
MIN_PROFIT_THRESHOLD=0.01
MAX_SPREAD_THRESHOLD=0.05

# Trading Settings
AUTO_TRADING_ENABLED=false    # Set to 'true' to enable automatic trading
DRY_RUN=true                  # Set to 'false' for live trading (BE CAREFUL!)
MAX_TRADE_SIZE=100.0          # Maximum amount in USD to invest per opportunity
# Polymarket API Credentials
POLYMARKET_API_KEY=your_api_key_here
POLYMARKET_SECRET=your_secret_here

# Wallet Configuration (for auto-trade mode)
WALLET_PRIVATE_KEY=your_private_key_here
WALLET_ADDRESS=your_wallet_address_here

# Polygon Network
POLYGON_RPC_URL=https://polygon-rpc.com

# Discord Notifications (optional)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_url

# Telegram Notifications (optional)
TELEGRAM_BOT_TOKEN=your_bot_token
TELEGRAM_CHAT_ID=your_chat_id

# Initial Capital (for position sizing)
INITIAL_CAPITAL=10000

# Advanced Settings
DEBUG=false
DRY_RUN=true

# Dashboard Configuration
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=5000
DASHBOARD_DEBUG=false

# Logging
LOG_LEVEL=INFO
LOG_DIR=logs

# Database (optional - for PostgreSQL persistence)
# DATABASE_URL=postgresql://user:password@localhost:5432/polymarket_bot
# REDIS_URL=redis://localhost:6379/0
